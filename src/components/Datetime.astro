---
import IconCalendar from "@/assets/icons/IconCalendar.svg";

type Props = {
  class?: string;
  size?: "sm" | "lg";
  date_created: string | Date;
};

const { date_created, size = "sm", class: className = "" } = Astro.props;

const datetime = new Date(date_created);
const date = new Intl.DateTimeFormat("fr-CA", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(datetime);
---

<div class:list={["flex items-center gap-x-2 opacity-80", className]}>
  <IconCalendar
    class:list={[
      "inline-block min-w-4 -translate-y-px",
      size === "sm" ? "size-4" : "size-5",
    ]}
  />
  <time
    class:list={["text-sm", { "sm:text-base": size === "lg" }]}
    datetime={datetime.toISOString()}>{date}</time
  >
</div>
